{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://content.arkodia.online/contracts/document.schema.json",
  "title": "Arkodia content document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "name",
    "assets",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "environment",
        "base",
        "character",
        "animation",
        "vfx"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "assets": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "environment",
              "base"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "width",
              "height",
              "layers"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "layers": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "objects"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "objects": {
                      "type": "array",
                      "maxItems": 100000,
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "character"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "animations"
            ],
            "properties": {
              "animations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "animation",
              "vfx"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "frames",
              "fps",
              "loop"
            ],
            "properties": {
              "fps": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 240
              },
              "loop": {
                "type": "boolean"
              },
              "frames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "object",
                  "required": [
                    "asset",
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "asset": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16384
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16384
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16384
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16384
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
